<html>
  <head>
    {{#if post}}
      <title>{{@site.title}}: {{meta_title}}</title>
    {{else}}
      <title>{{meta_title}}</title>
    {{/if}}
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, minimum-scale=1.0" />
    <link
      rel="stylesheet"
      id="carpeaqua-primary-css"
      type="text/css"
      href="{{asset 'built/main.css'}}"
    />
    <link
      rel="stylesheet"
      id="carpeaqua-prism-css"
      type="text/css"
      href="{{asset 'built/prism-tomorrow.css'}}"
    />
    <link
      rel="mask-icon"
      sizes="any"
      href="{{asset 'built/icon-mask.svg'}}"
      color="#4990E2"
    />
    <link
      rel="apple-touch-icon"
      href="{{asset 'built/apple-touch-icon.png'}}"
    />
    <link rel="shortcut icon" href="{{asset 'built/favicon.svg'}}" />
    {{ghost_head}}
    <meta property="og:image" content="{{asset 'built/card-image.png'}}" />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:locale" content="en_US" />
    {{!-- prettier-ignore --}}
    <script>
      (function () {
        var stored = localStorage.getItem('theme');
        var dark = stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>
  </head>

  <body class="{{body_class}}">
    <header class="site-header">
      <a href="{{@site.url}}" class="site-header__wordmark">Justin
        <span>Williams</span></a>
      <nav class="site-header__nav">
        <a href="{{@site.url}}#career">Career</a>
        <a href="{{@site.url}}#projects">Projects</a>
        <a href="{{@site.url}}#writing">Writing</a>
        <a href="{{@site.url}}#contact">Contact</a>
        <button
          type="button"
          id="theme-toggle"
          class="theme-toggle"
        >Dark</button>
      </nav>
    </header>

    <main class="text-left my-0 mb-8 bg-white dark:bg-dark-bg block">
      {{{body}}}
    </main>

    <footer class="site-footer">
      {{> "social-links"}}
      <span>&copy; Justin Williams</span>
    </footer>

    {{ghost_foot}}
    <script
      type="text/javascript"
      src="{{asset 'built/prism.min.js'}}"
    ></script>
    {{!-- prettier-ignore --}}
    <script>
      (function () {
        var btn = document.getElementById('theme-toggle');
        if (!btn) return;
        var setLabel = function () {
          btn.textContent = document.documentElement.classList.contains('dark') ? 'Light' : 'Dark';
        };
        setLabel();
        btn.addEventListener('click', function () {
          var isDark = document.documentElement.classList.toggle('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
          setLabel();
        });
      })();
    </script>
  </body>
</html>
