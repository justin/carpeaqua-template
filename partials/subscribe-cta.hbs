{{#unless @member}}
  <div class="subscribe-cta">
    <div class="subscribe-cta__badge">
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="#ffffff"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      ><rect x="2.5" y="5" width="19" height="14" rx="2.5"></rect><path
          d="M3 6.5l9 6.5 9-6.5"
        ></path></svg>
    </div>
    <div class="subscribe-cta__body">
      <h3>Get new posts by email</h3>
      <p>No spam &mdash; just an email whenever I publish something new.</p>
      <form data-members-form="signup">
        <input
          class="form-input"
          style="flex:1 1 220px"
          type="email"
          name="email"
          data-members-email
          placeholder="you@example.com"
          required
        />
        <button class="btn-primary" type="submit">
          <span data-members-label="default">Subscribe</span>
          <span data-members-label="loading" hidden>Sending&hellip;</span>
          <span data-members-label="success" hidden>Sent!</span>
          <span data-members-label="error" hidden>Error</span>
        </button>
      </form>
      <a href="{{@site.url}}blog/rss/" class="subscribe-cta__rss">
        <svg
          width="15"
          height="15"
          viewBox="0 0 16 16"
          fill="currentColor"
        ><path
            d="M2 2a1 1 0 0 1 1-1c6.627 0 12 5.373 12 12a1 1 0 1 1-2 0A10 10 0 0 0 3 3a1 1 0 0 1-1-1zm0 5a1 1 0 0 1 1-1 7 7 0 0 1 7 7 1 1 0 1 1-2 0 5 5 0 0 0-5-5 1 1 0 0 1-1-1zm2.5 8a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3z"
          ></path></svg>
        Subscribe via RSS
      </a>
    </div>
  </div>
{{/unless}}