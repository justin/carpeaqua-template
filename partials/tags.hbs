{{#if tags}}
  <section id="post-tags">
    <h6>Filed under</h6>
    <ul>
      {{#foreach tags}}
        <li>
          <a
            href="{{url}}"
            title="{{name}}"
            class="tag tag-{{comment_id}} {{slug}}"
          >{{name}}</a>
        </li>
      {{/foreach}}
    </ul>
  </section>
{{/if}}